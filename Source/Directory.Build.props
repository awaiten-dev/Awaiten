<Project>

	<Import Project="$(MSBuildThisFileDirectory)/../Directory.Build.props"
			Condition="Exists('$(MSBuildThisFileDirectory)/../Directory.Build.props')"/>

	<PropertyGroup>
		<Authors>Awaiten</Authors>
		<Description>Compile-time dependency injection for .NET.</Description>
		<Copyright>Copyright (c) 2026 - $([System.DateTime]::Now.ToString('yyyy')) Valentin Breuß</Copyright>
		<PackageProjectUrl>https://awaiten.dev</PackageProjectUrl>
		<RepositoryUrl>https://github.com/awaiten-dev/Awaiten.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>Docs/logo.png</PackageIcon>
		<PackageReadmeFile>Docs/README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);1701;1702</NoWarn>
		<WarningsNotAsErrors>CS1591;NU5104</WarningsNotAsErrors>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<Nullable>annotations</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Nullable">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!--
	    Awaiten uses the README of the repository; another package sets `PackageReadmeSourceFile` to its own in its project
	    file. The items are evaluated after all properties, so they see the value of the project file.
	-->
	<PropertyGroup>
		<PackageReadmeSourceFile>$(MSBuildThisFileDirectory)../README.md</PackageReadmeSourceFile>
		<PackageReadmeSourceFile Condition="Exists('$(MSBuildThisFileDirectory)../Artifacts/README.md')">$(MSBuildThisFileDirectory)../Artifacts/README.md</PackageReadmeSourceFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$([MSBuild]::GetPathOfFileAbove('logo.png', '$(MSBuildThisFileDirectory)../Docs/'))"
			  Pack="true"
			  PackagePath="/Docs/"
			  Link="\Docs\logo.png"/>
		<None Include="$(PackageReadmeSourceFile)"
			  Pack="true"
			  PackagePath="Docs/README.md"
			  Link="Docs\README.md"/>
	</ItemGroup>

</Project>
