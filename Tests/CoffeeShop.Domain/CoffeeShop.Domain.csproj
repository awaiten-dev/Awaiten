<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>library</OutputType>
		<IsTestProject>false</IsTestProject>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- The coffee-shop domain of the examples, kept in an assembly of its own so the architecture test in
	     Awaiten.ExampleTests can check it as a whole. Only its CoffeeShop.Composition namespace references Awaiten,
	     through a [Module] that keeps the implementations internal. Not a test project. -->
	<ItemGroup>
		<PackageReference Remove="TUnit.Engine" />
		<PackageReference Remove="Microsoft.Testing.Extensions.TrxReport" />
		<PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage" />
		<PackageReference Remove="aweXpect" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\Awaiten.SourceGenerators\Awaiten.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\Source\Awaiten\Awaiten.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="IsExternalInit">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
