<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>library</OutputType>
		<IsTestProject>false</IsTestProject>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- A plain support library referenced by Awaiten.Tests that plays a production assembly: it declares a
	     [Container] that a test container in Awaiten.Tests extends across the assembly boundary. Kept apart from
	     Awaiten.Tests.Support, because an assembly that declares a [Container] is a composition root, for which the
	     boundary analyzer does not report AWT134. Not a test project. -->
	<ItemGroup>
		<PackageReference Remove="TUnit.Engine" />
		<PackageReference Remove="Microsoft.Testing.Extensions.TrxReport" />
		<PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage" />
		<PackageReference Remove="aweXpect" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\Awaiten.SourceGenerators\Awaiten.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\Source\Awaiten\Awaiten.csproj" />
		<ProjectReference Include="..\Awaiten.Tests.Support\Awaiten.Tests.Support.csproj" />
	</ItemGroup>

	<!-- The decorator and composite shapes of internal services and the private member shapes that Awaiten.Tests.Support declares too, compiled here
	     once more so a container in this assembly and one granted InternalsVisibleTo build exactly the shapes that a
	     container in Awaiten.Tests builds without it. -->
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);CONTAINER_SUPPORT</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\Awaiten.Tests.Support\CrossAssemblyHiddenDecoratorShapes.cs" Link="CrossAssemblyHiddenDecoratorShapes.cs" />
		<Compile Include="..\Awaiten.Tests.Support\CrossAssemblyTuckedShapes.cs" Link="CrossAssemblyTuckedShapes.cs" />
	</ItemGroup>

	<!-- The init accessors of CrossAssemblyFriendInjectedShapesModule on net48. Awaiten.Tests, which this assembly
	     grants InternalsVisibleTo, uses this copy too, since a second one would conflict (CS0436). -->
	<ItemGroup>
		<PackageReference Include="IsExternalInit">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
